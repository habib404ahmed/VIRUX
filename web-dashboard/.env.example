# ============================================================
# VIRUX Web Dashboard — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to source control.
#
# All variables MUST be prefixed with VITE_ to be exposed
# to the browser bundle by Vite.
# ============================================================

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=virux-504a5.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=virux-504a5
VITE_FIREBASE_STORAGE_BUCKET=virux-504a5.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here

# Optional: Google Analytics Measurement ID
# VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# App configuration
VITE_APP_NAME=VIRUX
VITE_APP_VERSION=0.1.0-alpha
VITE_APP_ENVIRONMENT=development

