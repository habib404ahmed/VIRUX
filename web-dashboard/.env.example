# ============================================================
# VIRUX Web Dashboard — Environment Variables (.env.example)
# ============================================================
# Copy this file to .env.local and populate with your Firebase credentials.
# NEVER commit .env.local or secret-bearing files to source control.
#
# All variables MUST be prefixed with VITE_ to be exposed to Vite client bundle.
# ============================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Application Metadata
VITE_APP_NAME=VIRUX
VITE_APP_VERSION=0.1.0-alpha
VITE_APP_ENVIRONMENT=development
